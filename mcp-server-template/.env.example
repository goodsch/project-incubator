# Project Incubator MCP - Notion Integration
# Copy to .env and fill in values

# Notion API key (from https://www.notion.so/my-integrations)
NOTION_API_KEY=secret_xxx

# Quick Capture database ID (create database with Capture, Type, Created, Processed properties)
NOTION_IDEAS_DB_ID=xxx-xxx-xxx

# Optional: Projects database ID
NOTION_PROJECTS_DB_ID=

# Optional: Session Log database ID
NOTION_SESSIONS_DB_ID=
