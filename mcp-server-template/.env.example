# Hatchery MCP - Notion Integration
# Copy to .env and fill in values

# Notion API key (from https://www.notion.so/my-integrations)
NOTION_API_KEY=secret_xxx

# Hub Page ID - Parent page for all projects
# Projects are created as child pages under this hub
# Get ID from page URL: notion.so/Your-Hub-Page-{ID}
NOTION_HUB_PAGE_ID=xxx-xxx-xxx

# Quick Capture database ID (optional)
# Create database with: Capture (title), Type (select), Processed (checkbox)
# Used for rapid idea capture that syncs across devices
NOTION_IDEAS_DB_ID=

# Note: The hub page provides visibility into all projects.
# Each project gets its own Design Doc page created automatically.
