{
  "version": "1.0",
  "skills": {
    "phase-capture": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "promptTriggers": {
        "keywords": ["idea", "project", "build", "create", "want to make", "thinking about"],
        "intentPatterns": [
          "(i want|i need|thinking about|would like).*?(build|create|make|develop)",
          "new project",
          "start.*?project"
        ]
      },
      "fileTriggers": {
        "pathPatterns": ["projects/*/CONTEXT.md"],
        "contentPatterns": ["^$", "TODO", "idea"]
      }
    },
    "phase-expand": {
      "type": "guardrail",
      "enforcement": "block",
      "priority": "critical",
      "promptTriggers": {
        "keywords": ["expand", "explore", "questions", "user", "problem", "success"],
        "intentPatterns": [
          "(who|what|why|how).*?(user|problem|success|feature)",
          "expand.*?idea",
          "socratic"
        ]
      },
      "fileTriggers": {
        "pathPatterns": ["projects/*/CONTEXT.md"],
        "contentPatterns": [".{50,}"]
      },
      "blockMessage": "Phase 2 (EXPAND) requires Phase 1 (CAPTURE) to be complete.\n\nRun /validate to check if CONTEXT.md meets the gate criteria (>50 words of substantive content).\n\nIf validated, run /advance to proceed to Phase 2.",
      "skipConditions": {
        "sessionSkillUsed": true
      }
    },
    "phase-specify": {
      "type": "guardrail",
      "enforcement": "block",
      "priority": "critical",
      "promptTriggers": {
        "keywords": ["spec", "prd", "requirements", "features", "document"],
        "intentPatterns": [
          "(write|create|generate).*?(spec|prd|requirements)",
          "feature.*?list",
          "acceptance.*?criteria"
        ]
      },
      "fileTriggers": {
        "pathPatterns": ["projects/*/spec/*.md"]
      },
      "blockMessage": "Phase 3 (SPECIFY) requires Phase 2 (EXPAND) to be complete.\n\nAll macro questions must be answered:\n1. Who is the primary user?\n2. What is the core problem?\n3. What does success look like?\n4. What are the essential features?\n5. What is out of scope?\n6. What does this replace/complement?\n\nRun /validate to check status.",
      "skipConditions": {
        "sessionSkillUsed": true
      }
    },
    "phase-architect": {
      "type": "guardrail",
      "enforcement": "block",
      "priority": "critical",
      "promptTriggers": {
        "keywords": ["architecture", "tech stack", "design", "structure", "database", "api"],
        "intentPatterns": [
          "(design|plan|architect).*?(system|app|project)",
          "tech.*?stack",
          "directory.*?structure"
        ]
      },
      "fileTriggers": {
        "pathPatterns": ["projects/*/decisions/*.md"]
      },
      "blockMessage": "Phase 4 (ARCHITECT) requires Phase 3 (SPECIFY) to be complete.\n\nPRD must pass completeness checklist:\n- Overview section present\n- Features section with acceptance criteria\n- User interaction model defined\n- Constraints & scope documented\n\nRun /validate to check PRD completeness.",
      "skipConditions": {
        "sessionSkillUsed": true
      }
    },
    "phase-configure": {
      "type": "guardrail",
      "enforcement": "block",
      "priority": "critical",
      "promptTriggers": {
        "keywords": ["configure", "claude code", "skills", "commands", "agents", "hooks"],
        "intentPatterns": [
          "(configure|setup|create).*?(skills|commands|agents)",
          "claude.*?code.*?config"
        ]
      },
      "blockMessage": "Phase 5 (CONFIGURE) requires Phase 4 (ARCHITECT) to be complete.\n\nAll architecture decisions must be documented:\n1. Project type\n2. Tech stack\n3. Directory structure\n4. Data model\n5. External dependencies\n6. Deployment model\n\nRun /validate to check architecture completeness.",
      "skipConditions": {
        "sessionSkillUsed": true
      }
    },
    "phase-seed": {
      "type": "guardrail",
      "enforcement": "block",
      "priority": "critical",
      "promptTriggers": {
        "keywords": ["seed", "generate", "create project", "output"],
        "intentPatterns": [
          "(seed|generate|create).*?(project|directory|workspace)",
          "output.*?project"
        ]
      },
      "blockMessage": "Phase 6 (SEED) requires Phase 5 (CONFIGURE) to be complete.\n\nClaude Code configuration must specify:\n1. CLAUDE.md content\n2. Required skills\n3. Required commands\n4. Required agents\n5. Recommended MCP servers\n\nRun /validate to check configuration completeness.",
      "skipConditions": {
        "sessionSkillUsed": true
      }
    },
    "clear-thought-guide": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "promptTriggers": {
        "keywords": ["think", "decide", "compare", "options", "trade-off", "risk"],
        "intentPatterns": [
          "(should i|which|what if|compare)",
          "(think|reason).*?(through|about)",
          "pros.*?cons"
        ]
      }
    }
  }
}
