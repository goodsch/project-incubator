{
  "name": "web-app",
  "description": "Web application template - SPAs, PWAs, and full-stack web apps",
  "projectType": "web-application",
  "recommendedStacks": {
    "frontend": ["vue", "react", "svelte"],
    "backend": ["supabase", "firebase", "express"],
    "database": ["supabase", "postgresql", "mongodb"],
    "hosting": ["vercel", "netlify", "railway"]
  },
  "defaultStack": {
    "frontend": "vue",
    "backend": "supabase",
    "database": "supabase",
    "hosting": "vercel"
  },
  "directoryStructure": {
    "src": {
      "components": {},
      "views": {},
      "composables": {},
      "utils": {},
      "assets": {}
    },
    "public": {},
    "tests": {}
  },
  "defaultSkills": [
    "frontend-dev-guidelines"
